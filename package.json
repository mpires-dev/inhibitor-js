{
  "name": "inhibitor-js-workspace",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.30.1",
  "scripts": {
    "build": "pnpm -r --filter './packages/**' build",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint packages/core/src packages/browser/src packages/transport/src packages/inhibitor/src apps/playground/src scripts benchmarks/browser tests/e2e playwright.config.ts vitest.config.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:package": "node scripts/check-package.mjs",
    "check:size": "node scripts/check-size.mjs",
    "bench": "node benchmarks/browser/run.mjs",
    "dev": "pnpm --filter playground dev"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@playwright/test": "^1.56.1",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
